server {
    listen 80;
    server_name weather.mikechristiansen.mooo.com;
    
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    
    root /usr/share/nginx/html;
    index index.html;
    
    location / {
        try_files $uri $uri/ /index.html;
    }
    
    # Allow directory listing for now (for testing)
    autoindex on;
}
